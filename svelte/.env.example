# Copy to .env.local and fill in. Secrets do NOT belong in this file or in any
# file that is committed.
#
# Two different homes, and the split matters:
#
#   SvelteKit (.env.local, and Vercel project settings)
#     Anything the browser is allowed to see. PUBLIC_-prefixed by convention.
#
#   Convex deployment env (`npx convex env set NAME value`)
#     Every secret. SvelteKit server code never reads one of these — it only
#     forwards the Better Auth session token, so a leak in the web tier cannot
#     become a leak of Stripe credentials.

# ------------------------------------------------------------------
# SvelteKit
# ------------------------------------------------------------------

# From `npx convex dev`.
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# Our PLATFORM publishable key, used for every org. Connected accounts do not
# have publishable keys of their own; the donor page scopes itself to one by
# passing { stripeAccount } to loadStripe.
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------
# Convex deployment env — set with `npx convex env set`, never here
# ------------------------------------------------------------------
#
# npx convex env set STRIPE_SECRET_KEY sk_test_...
#   Platform secret key. Calls against a connected account use this key plus
#   { stripeAccount } in the request options.
#
# npx convex env set STRIPE_CONNECT_WEBHOOK_SECRET whsec_...
#   Signing secret for https://<deployment>.convex.site/stripe/connect-webhook.
#   Under direct charges this endpoint carries nearly all donation traffic.
#
# npx convex env set STRIPE_PLATFORM_WEBHOOK_SECRET whsec_...
#   Signing secret for https://<deployment>.convex.site/stripe/webhook, our own
#   account's events. Must NEVER be the same value as the Connect secret.
#
# npx convex env set STRIPE_DONATION_DOMAINS give.example.org,example.org
#   Comma-separated domains serving the donation form. Each is registered on
#   every connected account for Apple Pay / Google Pay / Link. No wildcards;
#   every subdomain is its own registration.
#
# Already in use, listed so a fresh deployment is not missing them:
#   EMAIL_SEND_FROM, BRAND_LOGO_URL, BRAND_NAME, BRAND_TAGLINE
